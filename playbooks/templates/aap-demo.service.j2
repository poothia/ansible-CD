[Unit]
Description=Demo Web App (Gunicorn)
After=network.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}
EnvironmentFile=/opt/aap-demo/env
ExecStart={{ venv_dir }}/bin/gunicorn wsgi:app \
    --bind {{ gunicorn_bind }} \
    --workers 2 \
    --timeout 30 \
    --access-logfile /var/log/aap-demo/access.log \
    --error-logfile /var/log/aap-demo/error.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
